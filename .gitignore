# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
doc
docs

# Env files — real credentials never get committed, .env.example is the
# only tracked template. doc/.env is a personal-reference copy, not a
# separate exemption.
.env
.env.*
!.env.example
doc/.env

# Capacitor native platforms. android/ is generated (2026-09-28) and
# COMMITTED, with its own android/.gitignore keeping build output, .gradle,
# local.properties and the copied web assets out. ios/ is not generated yet
# (out of scope); it stays ignored until `npx cap add ios` is decided.
ios/

# Verification screenshots (per-task review artifacts, not committed)
review-shots/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Additional build/tool output and caches
.pnp
.pnp.js
build/
.next/
out/
.supabase/
supabase/.temp/
.turbo/
.cache/
coverage/
Thumbs.db
*.swp
*.swo

# Docs folders (per the owner's request). Files already tracked in docs/ stay
# tracked; only NEW files under docs/ or doc/ are ignored.
docs/
doc/
