# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
doc
docs

# Env files — real credentials never get committed, .env.example is the
# only tracked template. doc/.env is a personal-reference copy, not a
# separate exemption.
.env
.env.*
!.env.example
doc/.env

# Capacitor native platforms — not generated yet, but ignored the moment
# `npx cap add ios` / `npx cap add android` create them.
ios/
android/

# Verification screenshots (per-task review artifacts, not committed)
review-shots/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Additional build/tool output and caches
.pnp
.pnp.js
build/
.next/
out/
.supabase/
.turbo/
.cache/
coverage/
Thumbs.db
*.swp
*.swo

# Docs folders (per the owner's request). Files already tracked in docs/ stay
# tracked; only NEW files under docs/ or doc/ are ignored.
docs/
doc/
